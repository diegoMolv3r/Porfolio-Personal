---
interface Props {
  title?: string;
  class?: string;
}

const { title, class: className } = Astro.props;
---

<div class={`retro-window ${className || ''}`}>
  {title && (
    <div class="retro-window-header">
      <div class="retro-window-title">{title}</div>
      <div class="retro-window-controls">
        <button class="retro-btn" aria-label="Minimize">_</button>
        <button class="retro-btn" aria-label="Maximize">□</button>
        <button class="retro-btn" aria-label="Close">×</button>
      </div>
    </div>
  )}
  <div class="retro-window-content">
    <slot />
  </div>
</div>

<style>
  .retro-window-content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    overflow-y: auto;
    overflow-x: hidden;
  }
</style>
