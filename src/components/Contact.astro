---
import RetroButton from "./RetroButton.astro";
---

<div class="flex flex-col gap-6 w-full max-w-4xl mx-auto">
  <div class="border-b-2 border-[var(--border-window)] pb-2">
    <h2 class="text-3xl text-[var(--accent-primary)] m-0 font-bold tracking-widest uppercase">>>_INITIATE_CONTACT</h2>
    <span class="text-[var(--text-muted)] text-sm block mt-1">> Enviar un paquete TCP al servidor principal...</span>
  </div>

  <div class="bg-black border-2 border-[var(--border-dim)] shadow-[4px_4px_0_0_var(--border-window)] p-6 md:p-10 relative">
    <div class="absolute top-0 right-0 bg-[var(--border-window)] text-black px-3 py-1 font-bold text-xs uppercase tracking-widest">
      PORT: 8080
    </div>

    <form
      action="https://formsubmit.co/molverdiego@gmail.com"
      class="space-y-6 mt-4"
      id="contact-form"
      method="POST"
    >
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="flex flex-col">
          <label for="nombre" class="text-[var(--text-muted)] font-bold text-xs uppercase tracking-widest mb-2">>_IDENTIFICADOR (Nombre)</label>
          <input
            type="text"
            name="nombre"
            id="nombre"
            placeholder="Introduce tu nombre"
            required
            class="bg-[var(--bg-deepest)] border border-[var(--border-dim)] focus:border-[var(--accent-primary)] focus:shadow-[0_0_10px_rgba(0,255,0,0.2)] text-[var(--text-primary)] px-4 py-3 outline-none font-mono transition-all rounded-none placeholder:text-[var(--border-dim)]"
          />
        </div>
        <div class="flex flex-col">
          <label for="asunto" class="text-[var(--text-muted)] font-bold text-xs uppercase tracking-widest mb-2">>_ASUNTO (Subject)</label>
          <input
            type="text"
            name="asunto"
            id="asunto"
            placeholder="¿De qué trata?"
            required
            class="bg-[var(--bg-deepest)] border border-[var(--border-dim)] focus:border-[var(--accent-primary)] focus:shadow-[0_0_10px_rgba(0,255,0,0.2)] text-[var(--text-primary)] px-4 py-3 outline-none font-mono transition-all rounded-none placeholder:text-[var(--border-dim)]"
          />
        </div>
      </div>

      <div class="flex flex-col">
        <label for="email" class="text-[var(--text-muted)] font-bold text-xs uppercase tracking-widest mb-2">>_ORIGEN (Email)</label>
        <input
          type="email"
          name="email"
          id="email"
          placeholder="usuario@servidor.com"
          required
          class="bg-[var(--bg-deepest)] border border-[var(--border-dim)] focus:border-[var(--accent-primary)] focus:shadow-[0_0_10px_rgba(0,255,0,0.2)] text-[var(--text-primary)] px-4 py-3 outline-none font-mono transition-all rounded-none placeholder:text-[var(--border-dim)]"
        />
      </div>

      <div class="flex flex-col">
        <label for="mensaje" class="text-[var(--text-muted)] font-bold text-xs uppercase tracking-widest mb-2">>_PAYLOAD (Mensaje)</label>
        <textarea
          name="mensaje"
          id="mensaje"
          placeholder="Escribe el contenido del mensaje aquí..."
          rows="5"
          required
          class="bg-[var(--bg-deepest)] border border-[var(--border-dim)] focus:border-[var(--accent-primary)] focus:shadow-[0_0_10px_rgba(0,255,0,0.2)] text-[var(--text-primary)] px-4 py-3 outline-none font-mono transition-all rounded-none placeholder:text-[var(--border-dim)] resize-none"
        ></textarea>
      </div>

      <input type="hidden" name="_captcha" value="false" />
      <input type="hidden" name="_next" value="https://molver.netlify.app/#contacto" />

      <div class="pt-4">
        <button
          type="submit"
          class="w-full md:w-auto bg-[var(--accent-primary)] text-black border-2 border-[var(--accent-primary)] font-bold uppercase tracking-widest px-8 py-3 flex items-center justify-center gap-3 hover:bg-black hover:text-[var(--accent-primary)] transition-colors shadow-[4px_4px_0_0_var(--border-dim)] hover:shadow-none hover:translate-x-[4px] hover:translate-y-[4px]"
        >
          <i class="bi bi-terminal text-lg"></i>
          EJECUTAR_ENVIO()
        </button>
      </div>
    </form>
  </div>
</div>
