---
import RetroButton from "./RetroButton.astro";

const PROJECTS = [
  {
    titulo: "RECRED",
    descripcion:
      "Proyecto <span class=\"text-white font-bold\">final de carrera</span>. Desarrollo de un producto completo, abarcando desde la <span class=\"text-white font-bold\">creación de la marca</span>, modelo de negocios y manual de usuario, hasta el <span class=\"text-white font-bold\">desarrollo Full Stack</span>. Arquitectura Frontend con <span class=\"text-white font-bold\">Angular</span> y Backend con <span class=\"text-white font-bold\">Java Spring Boot</span>. Deployado en Netlify y AWS.",
    tecnologias: ["Angular", "Java", "Spring Boot", "PostgreSQL", "Netlify", "AWS"],
    enlace: null,
    sitio: "https://landing-recred.netlify.app/",
  },
  {
    titulo: "OWASP TOP 10 con .NET Core",
    descripcion:
      "Proyecto que realicé durante la cursada de la materia <span class=\"text-white font-bold\">\"Programación web III\"</span>, donde grupalmente nos tocó desarrollar un proyecto bajo el ecosistema de tecnologias de Microsoft, el tema del mismo era la <span class=\"text-white font-bold\">Ciberseguridad</span>, por lo que desarrollamos una <span class=\"text-white font-bold\">Aplicacion de Tickets</span> en la cual se aplican la prácticas mencionadas en el <span class=\"text-white font-bold\">OWASP TOP 10 (2025)</span>. ",
    tecnologias: ["C#", "Entity Framework", "SQL Server"],
    enlace: "https://github.com/diegoMolv3r/CRUD-en-.NET-con-SQL-SERVER",
    sitio: null,
  },
  {
    titulo: "SickDogs Ind",
    descripcion:
      "Catálogo web para la marca de ropa SickDogs. Con posbilidad de realizar pedidos por Instagram.",
    tecnologias: ["Angular"],
    enlace: "https://github.com/diegoMolv3r/SickDogsInd",
    sitio: "https://sickdogs.netlify.app/",
  },
  {
    titulo: "Quiz Code",
    descripcion:
      "Juego de preguntas y respuestas con lógica de dificultad adaptativa y puntuacion.",
    tecnologias: ["PHP", "MySQL", "Bootstrap", "Mustache"],
    enlace: "https://github.com/Urielito1031/preguntados-app-mvc",
    sitio: null,
  },
  {
    titulo: "FutCode",
    descripcion:
      "Juego de fútbol online en el cual podes formar tu propio equipo y jugar contra otros usuarios.",
    tecnologias: ["Java", "Hibernate", "MySQL", "Spring MVC"],
    enlace: "https://github.com/Urielito1031/Taller-webi-FutCode",
    sitio: null,
  },
];
---

<div class="flex flex-col gap-6 w-full">
  <div class="mb-6 border-b-2 border-[var(--border-window)] pb-2 flex justify-between items-end">
    <h2 class="text-3xl text-[var(--accent-primary)] m-0 font-bold tracking-widest">>> LST_PROYECTOS</h2>
    <span class="text-[var(--text-muted)] text-sm">Mostrando {PROJECTS.length} ejecutables</span>
  </div>

  <div class="flex flex-col gap-4">
    {
      PROJECTS.map((project, index) => {
        const fileId = (index + 1).toString().padStart(2, '0');
        const fileName = project.titulo.toLowerCase().replace(/ /g, '_').replace(/\./g, '') + '.exe';
        
        return (
          <details class="group bg-black border-2 border-[var(--border-dim)] hover:border-[var(--accent-primary)] transition-colors open:border-[var(--accent-primary)] shadow-[2px_2px_0_0_var(--border-dim)] open:shadow-[4px_4px_0_0_var(--accent-primary)]">
            <summary class="flex justify-between items-center p-4 cursor-pointer list-none text-white hover:text-[var(--accent-primary)] transition-colors">
              <div class="flex items-center gap-4">
                <span class="text-[var(--text-muted)] group-hover:text-[var(--text-primary)]">[{fileId}]</span>
                <span class="text-xl md:text-2xl font-bold uppercase tracking-wider">{project.titulo}</span>
              </div>
              <div class="flex items-center gap-4">
                <span class="hidden md:inline-block text-[var(--text-muted)] group-hover:text-[var(--text-primary)]">{fileName}</span>
                <i class="bi bi-chevron-down group-open:rotate-180 transition-transform text-[var(--accent-primary)]"></i>
              </div>
            </summary>
            
            <div class="p-6 border-t-2 border-dashed border-[var(--border-dim)] bg-[var(--bg-window)] flex flex-col gap-6">
              <div>
                <span class="text-[var(--text-muted)] block mb-1">>_ INFO_FILE</span>
                <p class="text-[var(--text-primary)] text-lg md:text-xl leading-relaxed m-0" set:html={project.descripcion}></p>
              </div>

              <div>
                <span class="text-[var(--text-muted)] block mb-2">>_ REQ_DEPENDENCIES</span>
                <div class="flex flex-wrap gap-2">
                  {project.tecnologias.map((tec) => (
                    <span class="bg-[var(--bg-deepest)] text-[var(--accent-primary)] border border-[var(--accent-primary)] px-2 py-1 text-sm uppercase">
                      {tec}
                    </span>
                  ))}
                </div>
              </div>

              <div class="mt-4 flex flex-wrap gap-4">
                {project.enlace && (
                  <RetroButton
                    href={project.enlace}
                    text="CÓDIGO FUENTE"
                    icon="bi bi-github"
                    target="_blank"
                    variant="primary"
                  />
                )}
                {project.sitio && (
                  <RetroButton
                    href={project.sitio}
                    text="EJECUTAR DEMO"
                    icon="bi bi-box-arrow-up-right"
                    target="_blank"
                    variant="secondary"
                  />
                )}
              </div>
            </div>
          </details>
        );
      })
    }
  </div>
</div>

<style>
    details > summary::-webkit-details-marker {
    display: none;
  }
</style>
