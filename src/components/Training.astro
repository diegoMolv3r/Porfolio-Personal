---
import RetroButton from "./RetroButton.astro";

const ACADEMICO = [
  {
    titulo: "Tec. Universitaria en Desarrollo Web",
    institucion: "Universidad Nacional de La Matanza",
    periodo: "Marzo 2024 - Julio 2026 (Promedio: 8.75)",
    destacado: true,
  }
];

const CURSOS = [
   {
    titulo: "Testing QA",
    institucion: "Talento Tech",
    periodo: "Agosto 2026 - Actualidad",
    imagen: "",
    descripcion: "",
  },
  {
    titulo: "Desarrollo con IA: Programa con Agentes",
    institucion: "Big School",
    periodo: "Junio 2026",
    imagen: "",
    descripcion: "",
  },
  {
    titulo: "Ciberseguridad y Hacking Ético",
    institucion: "Big School",
    periodo: "Mayo 2026",
    imagen: "",
    descripcion: "",
  },
  {
    titulo: "Profesional en Ciberseguridad",
    institucion: "IBM Skill Build",
    periodo: "Abril 2026 - Actualidad",
    imagen: "",
    descripcion: "",
  },
  {
    titulo: "Iniciación al Desarrollo con IA",
    institucion: "Big School",
    periodo: "Marzo 2026",
    imagen: "",
    descripcion: "",
  },
  {
    titulo: "Introducción a la Ciberseguridad",
    institucion: "Fundación YPF",
    periodo: "Noviembre 2025 - Diciembre 2025",
    imagen: "",
    descripcion: "",
  },
  {
    titulo: "Professional Front-End Developer",
    institucion: "Universidad Tecnológica Nacional",
    periodo: "Marzo 2023 - Diciembre 2023",
    imagen: "",
    descripcion: "",
  }
];
---

<div class="flex flex-col gap-10 w-full relative">
  
    <div>
    <div class="mb-6 border-b-2 border-[var(--border-window)] pb-2">
      <h2 class="text-3xl text-[var(--accent-primary)] m-0 font-bold tracking-widest uppercase">>>_FORMACIÓN_ACADÉMICA</h2>
    </div>

    <div class="flex flex-col gap-4">
      {ACADEMICO.map((item) => (
        <div class="bg-black border-2 border-[var(--accent-primary)] shadow-[4px_4px_0_0_var(--accent-primary)] p-6 md:p-8 relative overflow-hidden">
          <div class="absolute top-0 right-0 bg-[var(--accent-primary)] text-black px-3 py-1 font-bold text-xs uppercase tracking-widest">
            En Curso
          </div>
          
          <h3 class="text-2xl md:text-3xl text-white font-bold mb-4 uppercase">
            {item.titulo}
          </h3>
          
          <div class="flex flex-col gap-2 text-lg">
            <div class="flex items-start gap-3 text-[var(--text-primary)]">
              <span class="text-[var(--text-muted)] w-24 flex-shrink-0">> INST:</span>
              <span class="uppercase font-bold">{item.institucion}</span>
            </div>
            <div class="flex items-start gap-3 text-[var(--text-primary)]">
              <span class="text-[var(--text-muted)] w-24 flex-shrink-0">> ESTADO:</span>
              <span>{item.periodo}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

    <div>
    <div class="mb-6 border-b-2 border-[var(--border-dim)] pb-2 flex justify-between items-end">
      <h2 class="text-2xl text-[var(--text-muted)] m-0 font-bold tracking-widest uppercase">>>_CERTIFICACIONES_Y_CURSOS</h2>
      <span class="text-[var(--text-muted)] text-sm">TOTAL: {CURSOS.length}</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {CURSOS.map((curso, i) => {
        const id = (i + 1).toString().padStart(2, '0');
        const desc = curso.descripcion || "Información detallada del curso no disponible. Inserte la descripción en el código.";
        const img = curso.imagen || "https://via.placeholder.com/800x600/000000/00ff00?text=CERTIFICADO+PENDIENTE";
        
        return (
          <div class="border border-[var(--border-dim)] bg-[var(--bg-deepest)] p-4 hover:border-[var(--border-window)] transition-colors group relative overflow-hidden flex flex-col justify-between">
            <div class="absolute left-0 top-0 bottom-0 w-1 bg-[var(--border-dim)] group-hover:bg-[var(--accent-primary)] transition-colors"></div>
            
            <div class="flex items-start gap-3 ml-2 mb-4">
              <span class="text-[var(--text-muted)] group-hover:text-[var(--text-primary)] font-bold">[{id}]</span>
              <div class="flex flex-col">
                <h4 class="text-lg text-white font-bold mb-1 group-hover:text-[var(--accent-primary)] transition-colors">
                  {curso.titulo}
                </h4>
                <span class="text-[var(--text-primary)] text-sm opacity-80 mb-1">
                  @ {curso.institucion}
                </span>
                <span class="text-[var(--text-muted)] text-xs">
                  > {curso.periodo}
                </span>
              </div>
            </div>

            <button 
              class="curso-modal-btn ml-2 bg-black border border-[var(--accent-primary)] text-[var(--accent-primary)] px-3 py-1 text-sm font-bold uppercase hover:bg-[var(--accent-primary)] hover:text-black transition-colors self-start hover-glitch shadow-[2px_2px_0_0_var(--accent-primary)] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none"
              data-titulo={curso.titulo}
              data-institucion={curso.institucion}
              data-periodo={curso.periodo}
              data-desc={desc}
              data-img={img}
            >
              + VER DETALLES
            </button>
          </div>
        );
      })}
    </div>
  </div>

    <div id="curso-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-[100] hidden flex-col justify-center items-center p-4">
    <div class="bg-[var(--bg-window)] border-2 border-[var(--border-window)] w-full max-w-4xl max-h-[90vh] flex flex-col shadow-[0_0_30px_rgba(0,255,0,0.2)] relative overflow-hidden">
            <div class="bg-[var(--accent-primary)] text-black px-4 py-2 flex justify-between items-center font-bold">
        <span class="tracking-widest uppercase" id="modal-header-title">VISOR_DE_CERTIFICADOS.EXE</span>
        <button id="close-modal-btn" class="bg-black text-[var(--accent-primary)] w-8 h-8 flex justify-center items-center hover:bg-white transition-colors border border-black cursor-pointer">
          X
        </button>
      </div>

            <div class="overflow-y-auto p-6 md:p-8 flex flex-col gap-6 custom-scrollbar">
        
        <div>
          <h3 id="modal-titulo" class="text-3xl md:text-4xl text-white font-extrabold uppercase mb-2"></h3>
          <p id="modal-institucion" class="text-xl text-[var(--text-primary)] mb-1"></p>
          <p id="modal-periodo" class="text-[var(--text-muted)] text-sm mb-0"></p>
        </div>

        <div class="border-t-2 border-dashed border-[var(--border-dim)] pt-6">
          <span class="text-[var(--text-muted)] block mb-4">>_ CAT CERTIFICADO.IMG</span>
          <img 
            id="modal-imagen" 
            src="" 
            alt="Certificado" 
            class="w-full h-auto max-h-[50vh] object-contain border-2 border-[var(--border-dim)] shadow-[0_0_15px_rgba(0,255,0,0.1)] p-2 bg-black"
          />
        </div>

        <div class="border-t-2 border-dashed border-[var(--border-dim)] pt-6">
          <span class="text-[var(--text-muted)] block mb-2">>_ CAT DESCRIPCION.TXT</span>
          <p id="modal-desc" class="text-[var(--text-primary)] text-lg leading-relaxed whitespace-pre-line"></p>
        </div>

      </div>
    </div>
  </div>

</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('curso-modal');
    const closeBtn = document.getElementById('close-modal-btn');
    const modalTitulo = document.getElementById('modal-titulo');
    const modalInstitucion = document.getElementById('modal-institucion');
    const modalPeriodo = document.getElementById('modal-periodo');
    const modalDesc = document.getElementById('modal-desc');
    const modalImagen = document.getElementById('modal-imagen');

    const openButtons = document.querySelectorAll('.curso-modal-btn');

    openButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        modalTitulo.textContent = btn.getAttribute('data-titulo');
        modalInstitucion.textContent = '@ ' + btn.getAttribute('data-institucion');
        modalPeriodo.textContent = '> ' + btn.getAttribute('data-periodo');
        modalDesc.textContent = btn.getAttribute('data-desc');
        modalImagen.src = btn.getAttribute('data-img');

        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
      });
    });

    closeBtn.addEventListener('click', () => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    });

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
      }
    });
  });
</script>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    width: 10px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: var(--bg-deepest);
    border-left: 1px solid var(--border-dim);
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: var(--border-dim);
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: var(--accent-primary);
  }
</style>
