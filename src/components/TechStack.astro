---
---

<div class="flex flex-col gap-6 w-full">
  <div class="border-b-2 border-[var(--border-window)] pb-2 flex justify-between items-end">
    <h2 class="text-3xl text-[var(--accent-primary)] m-0 font-bold tracking-widest uppercase">>>_SYS_SPECS</h2>
    <span class="text-[var(--text-muted)] text-sm">Mostrando Stack y Herramientas</span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="border border-[var(--border-dim)] bg-[var(--bg-deepest)] p-4 flex flex-col hover:border-[var(--accent-primary)] transition-colors group">
      <span class="text-[var(--text-muted)] group-hover:text-[var(--text-primary)] font-bold mb-3 block">>[DEV] DESARROLLO</span>
      <div class="flex flex-wrap gap-2">
        <span class="bg-black text-[var(--text-primary)] border border-[var(--accent-primary)] px-2 py-1 text-sm font-bold shadow-[2px_2px_0_0_var(--accent-primary)]">.NET(C#)</span>
        <span class="bg-black text-[var(--text-primary)] border border-[var(--accent-primary)] px-2 py-1 text-sm font-bold shadow-[2px_2px_0_0_var(--accent-primary)]">Angular</span>
      </div>
    </div>

        <div class="border border-[var(--border-dim)] bg-[var(--bg-deepest)] p-4 flex flex-col hover:border-[var(--accent-primary)] transition-colors group">
      <span class="text-[var(--text-muted)] group-hover:text-[var(--text-primary)] font-bold mb-3 block">>[DB] BASES DE DATOS</span>
      <div class="flex flex-wrap gap-2">
        <span class="bg-black text-[var(--text-primary)] border border-[var(--border-window)] px-2 py-1 text-sm font-bold group-hover:border-[var(--accent-primary)] transition-colors">MySQL</span>
        <span class="bg-black text-[var(--text-primary)] border border-[var(--border-window)] px-2 py-1 text-sm font-bold group-hover:border-[var(--accent-primary)] transition-colors">PostgreSQL</span>
      </div>
    </div>

        <div class="border border-[var(--border-dim)] bg-[var(--bg-deepest)] p-4 flex flex-col hover:border-[var(--accent-primary)] transition-colors group">
      <span class="text-[var(--text-muted)] group-hover:text-[var(--text-primary)] font-bold mb-3 block">>[TEST] TESTING</span>
      <div class="flex flex-wrap gap-2">
        <span class="bg-black text-[var(--text-primary)] border border-[var(--border-window)] px-2 py-1 text-sm font-bold group-hover:border-[var(--accent-primary)] transition-colors">TDD</span>
        <span class="bg-black text-[var(--text-primary)] border border-[var(--border-window)] px-2 py-1 text-sm font-bold group-hover:border-[var(--accent-primary)] transition-colors">JUnit</span>
        <span class="bg-black text-[var(--text-primary)] border border-[var(--border-window)] px-2 py-1 text-sm font-bold group-hover:border-[var(--accent-primary)] transition-colors">Jasmine</span>
      </div>
    </div>

        <div class="border border-[var(--border-dim)] bg-[var(--bg-deepest)] p-4 flex flex-col hover:border-[var(--accent-primary)] transition-colors group">
      <span class="text-[var(--text-muted)] group-hover:text-[var(--text-primary)] font-bold mb-3 block">>[OPS] DEVOPS & SEC</span>
      <div class="flex flex-wrap gap-2">
        <span class="bg-black text-[var(--text-primary)] border border-[var(--border-window)] px-2 py-1 text-sm font-bold group-hover:border-[var(--accent-primary)] transition-colors">Git</span>
        <span class="bg-black text-[var(--text-primary)] border border-[var(--border-window)] px-2 py-1 text-sm font-bold group-hover:border-[var(--accent-primary)] transition-colors">Github Actions</span>
        <span class="bg-black text-[var(--text-primary)] border border-[var(--border-window)] px-2 py-1 text-sm font-bold group-hover:border-[var(--accent-primary)] transition-colors">Docker</span>
        <span class="bg-black text-[var(--text-primary)] border border-[var(--border-window)] px-2 py-1 text-sm font-bold group-hover:border-[var(--accent-primary)] transition-colors">Linux</span>
        <span class="bg-black text-[var(--text-primary)] border border-[var(--border-window)] px-2 py-1 text-sm font-bold group-hover:border-[var(--accent-primary)] transition-colors">BurpSuite</span>
      </div>
    </div>
  </div>
</div>
