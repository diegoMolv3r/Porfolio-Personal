---
import RetroButton from "./RetroButton.astro";
---

<div class="flex flex-col md:flex-row h-full w-full">
  <div
    class="p-6 md:p-8 flex flex-col justify-center md:w-1/2 bg-[var(--bg-deepest)] border-b-4 md:border-b-0 md:border-r-4 border-[var(--border-window)]"
  >
    <div class="mb-6 md:mb-8">
      <h1
        class="text-4xl md:text-5xl lg:text-7xl leading-tight text-[var(--text-primary)] mb-2 font-extrabold tracking-tight min-h-[96px] md:min-h-[144px]"
        id="hero-title"
      >
        <span id="type-part-1"></span><br /><span
          id="type-part-2"
          class="text-white hover-glitch inline-block"></span><span
          class="blink">_</span
        >
      </h1>
      <h2 class="text-xl md:text-2xl text-[var(--text-muted)] mb-4">
        Desarrollador Web/Sec
      </h2>
      <p
        class="text-lg md:text-xl text-[var(--text-primary)] max-w-lg mb-6 leading-relaxed"
      >
        Actualmente formandome en el area de la
        <span class="text-white font-bold blink">Ciberseguridad</span>
        y el desarrollo de software.
      </p>

      <div class="flex flex-wrap gap-3 mb-6">
        <a
          href="https://www.linkedin.com/in/diego-molver-72b3a727b/"
          target="_blank"
          class="w-12 h-12 flex items-center justify-center bg-black border-2 border-[var(--border-window)] shadow-[2px_2px_0px_0px_var(--border-window)] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none text-[var(--accent-primary)] hover:bg-[var(--accent-primary)] hover:text-black transition-colors"
        >
          <i class="bi bi-linkedin text-2xl"></i>
        </a>
        <a
          href="https://github.com/diegoMolv3r"
          target="_blank"
          class="w-12 h-12 flex items-center justify-center bg-black border-2 border-[var(--border-window)] shadow-[2px_2px_0px_0px_var(--border-window)] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none text-[var(--accent-primary)] hover:bg-[var(--accent-primary)] hover:text-black transition-colors"
        >
          <i class="bi bi-github text-2xl"></i>
        </a>
        <a
          href="mailto:molverdiego@gmail.com"
          target="_blank"
          class="w-12 h-12 flex items-center justify-center bg-black border-2 border-[var(--border-window)] shadow-[2px_2px_0px_0px_var(--border-window)] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none text-[var(--accent-primary)] hover:bg-[var(--accent-primary)] hover:text-black transition-colors"
        >
          <i class="bi bi-envelope text-2xl"></i>
        </a>
      </div>
    </div>

    <div class="flex flex-wrap gap-4 mt-auto">
      <RetroButton
        href="/assets/Molver Diego Cv.pdf"
        text="Descargar CV"
        icon="bi bi-download"
        target="_blank"
        variant="primary"
        download={true}
      />
      <RetroButton
        href="https://wa.me/5491127090638"
        text="WhatsApp"
        icon="bi bi-whatsapp"
        target="_blank"
        variant="secondary"
      />
    </div>
  </div>

  <div
    class="bg-[var(--bg-window)] flex flex-col justify-center items-center md:w-1/2 relative overflow-hidden flex-grow min-h-[300px]"
  >
    <div
      class="absolute inset-0 opacity-10 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0MCIgaGVpZ2h0PSI0MCI+CjxwYXRoIGQ9Ik0wIDBoNDB2NDBIMHoiIGZpbGw9Im5vbmUiLz4KPHBhdGggZD0iTTAgMGwxMCAxME00MCAwbC0xMCAxME0wIDQwbDEwLTEwTTQwIDQwbC0xMC0xMCIgc3Ryb2tlPSIjMDBmZjAwIiBzdHJva2Utd2lkdGg9IjEiLz4KPC9zdmc+')] pointer-events-none"
    >
    </div>

    <div
      class="relative group w-full h-full flex justify-center items-center z-10 p-4"
    >
      <div
        class="absolute inset-4 bg-[var(--accent-primary)] mix-blend-multiply opacity-50 group-hover:opacity-0 transition-opacity duration-300 pointer-events-none z-20"
      >
      </div>
      <img
        src="/assets/img/Diego.png"
        alt="Foto de Diego Molver"
        class="w-full h-full object-contain max-h-[70vh] md:max-h-[80vh] filter drop-shadow-[0_0_15px_rgba(0,255,0,0.5)]"
      />
    </div>

    <div
      class="absolute bottom-4 right-4 bg-black text-[var(--accent-primary)] border border-[var(--border-dim)] px-3 py-1 font-bold text-sm tracking-widest uppercase flex items-center gap-2 shadow-[0_0_8px_var(--accent-primary)] z-30"
    >
      <span class="w-2 h-2 bg-[var(--accent-primary)] blink inline-block"
      ></span>
      SYS_READY
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const text1 = "Diego Luciano ";
    const text2 = "Molver";

    const el1 = document.getElementById("type-part-1");
    const el2 = document.getElementById("type-part-2");

    if (!el1 || !el2) return;

    let i = 0;
    let j = 0;

    function typeWriter1() {
      if (i < text1.length) {
        el1.innerHTML += text1.charAt(i);
        i++;
        setTimeout(typeWriter1, Math.random() * 50 + 50);
      } else {
        setTimeout(typeWriter2, 200);
      }
    }

    function typeWriter2() {
      if (j < text2.length) {
        el2.innerHTML += text2.charAt(j);
        j++;
        setTimeout(typeWriter2, Math.random() * 50 + 50);
      }
    }

    setTimeout(typeWriter1, 500);
  });
</script>
