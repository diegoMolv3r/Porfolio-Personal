---
import RetroButton from "./RetroButton.astro";
---

<div class="flex flex-col md:flex-row h-full w-full">
  <div
    class="p-4 sm:p-6 lg:p-8 xl:p-10 flex flex-col justify-center md:w-1/2 lg:w-[55%] bg-[var(--bg-deepest)] border-b-4 md:border-b-0 md:border-r-4 border-[var(--border-window)] min-w-0"
  >
    <div class="mb-5 md:mb-8">
      <h1
        class="text-[clamp(2rem,9vw,2.75rem)] md:text-[clamp(2.5rem,5.2vw,3.25rem)] lg:text-[clamp(3.25rem,4.8vw,4.5rem)] leading-[1.1] text-[var(--text-primary)] mb-2 font-extrabold tracking-tight min-h-[2.2em]"
        id="hero-title"
      >
        <span id="type-part-1"></span><br /><span
          id="type-part-2"
          class="text-white hover-glitch inline-block"></span><span
          class="blink">_</span
        >
      </h1>
      <h2 class="text-xl md:text-2xl text-[var(--text-muted)] mb-3 md:mb-4">
        Desarrollador Web/Sec
      </h2>
      <p
        class="text-lg md:text-xl text-[var(--text-primary)] max-w-lg mb-5 md:mb-6 leading-relaxed"
      >
        Actualmente formandome en el area de la
        <span class="text-white font-bold blink">Ciberseguridad</span>
        y el desarrollo de software.
      </p>

      <div class="flex flex-wrap gap-3 mb-2 md:mb-6">
        <a
          href="https://www.linkedin.com/in/diego-molver-72b3a727b/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="w-11 h-11 sm:w-12 sm:h-12 flex items-center justify-center bg-black border-2 border-[var(--border-window)] shadow-[2px_2px_0px_0px_var(--border-window)] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none text-[var(--accent-primary)] hover:bg-[var(--accent-primary)] hover:text-black transition-colors"
        >
          <i class="bi bi-linkedin text-xl sm:text-2xl"></i>
        </a>
        <a
          href="https://github.com/diegoMolv3r"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="w-11 h-11 sm:w-12 sm:h-12 flex items-center justify-center bg-black border-2 border-[var(--border-window)] shadow-[2px_2px_0px_0px_var(--border-window)] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none text-[var(--accent-primary)] hover:bg-[var(--accent-primary)] hover:text-black transition-colors"
        >
          <i class="bi bi-github text-xl sm:text-2xl"></i>
        </a>
        <a
          href="mailto:molverdiego@gmail.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Email"
          class="w-11 h-11 sm:w-12 sm:h-12 flex items-center justify-center bg-black border-2 border-[var(--border-window)] shadow-[2px_2px_0px_0px_var(--border-window)] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none text-[var(--accent-primary)] hover:bg-[var(--accent-primary)] hover:text-black transition-colors"
        >
          <i class="bi bi-envelope text-xl sm:text-2xl"></i>
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 min-[400px]:grid-cols-2 sm:flex sm:flex-wrap gap-3 sm:gap-4 mt-2 md:mt-auto">
      <RetroButton
        href="/assets/Molver Diego Cv.pdf"
        text="Descargar CV"
        icon="bi bi-download"
        target="_blank"
        variant="primary"
        download={true}
      />
      <RetroButton
        href="https://wa.me/5491127090638"
        text="WhatsApp"
        icon="bi bi-whatsapp"
        target="_blank"
        variant="secondary"
      />
    </div>
  </div>

  <div
    class="bg-[var(--bg-window)] flex flex-col justify-center items-center md:w-1/2 lg:w-[45%] relative overflow-hidden flex-grow min-h-[220px] sm:min-h-[280px] md:min-h-[300px]"
  >
    <div
      class="absolute inset-0 opacity-10 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0MCIgaGVpZ2h0PSI0MCI+CjxwYXRoIGQ9Ik0wIDBoNDB2NDBIMHoiIGZpbGw9Im5vbmUiLz4KPHBhdGggZD0iTTAgMGwxMCAxME00MCAwbC0xMCAxME0wIDQwbDEwLTEwTTQwIDQwbC0xMC0xMCIgc3Ryb2tlPSIjMDBmZjAwIiBzdHJva2Utd2lkdGg9IjEiLz4KPC9zdmc+')] pointer-events-none"
    >
    </div>

    <div
      class="relative group w-full h-full flex justify-center items-center z-10 p-4"
    >
      <div
        class="absolute inset-4 bg-[var(--accent-primary)] mix-blend-multiply opacity-50 group-hover:opacity-0 transition-opacity duration-300 pointer-events-none z-20"
      >
      </div>
      <img
        src="/assets/img/Diego.png"
        alt="Foto de Diego Molver"
        class="w-full h-full object-contain max-h-[45svh] sm:max-h-[50svh] md:max-h-[70svh] lg:max-h-[75svh] filter drop-shadow-[0_0_15px_rgba(0,255,0,0.5)]"
        loading="eager"
        decoding="async"
      />
    </div>

    <div
      class="absolute bottom-2 right-2 md:bottom-4 md:right-4 bg-black text-[var(--accent-primary)] border border-[var(--border-dim)] px-2 md:px-3 py-1 font-bold text-xs md:text-sm tracking-widest uppercase flex items-center gap-2 shadow-[0_0_8px_var(--accent-primary)] z-30"
    >
      <span class="w-2 h-2 bg-[var(--accent-primary)] blink inline-block"
      ></span>
      SYS_READY
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const text1 = "Diego Luciano ";
    const text2 = "Molver";

    const el1 = document.getElementById("type-part-1");
    const el2 = document.getElementById("type-part-2");

    if (!el1 || !el2) return;

    let i = 0;
    let j = 0;

    function typeWriter1() {
      if (i < text1.length) {
        el1.innerHTML += text1.charAt(i);
        i++;
        setTimeout(typeWriter1, Math.random() * 50 + 50);
      } else {
        setTimeout(typeWriter2, 200);
      }
    }

    function typeWriter2() {
      if (j < text2.length) {
        el2.innerHTML += text2.charAt(j);
        j++;
        setTimeout(typeWriter2, Math.random() * 50 + 50);
      }
    }

    setTimeout(typeWriter1, 500);
  });
</script>
