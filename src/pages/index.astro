---
import Layout from "../layouts/Layout.astro";
import RetroWindow from "../components/RetroWindow.astro";
import AboutMe from "../components/AboutMe.astro";
import TechStack from "../components/TechStack.astro";
import Projects from "../components/Projects.astro";
import Training from "../components/Training.astro";
import Contact from "../components/Contact.astro";
import Hero from "../components/Hero.astro";
import Experience from "../components/Experience.astro";

const NAV_LINKS = [
  { href: "#perfil", label: "cd /perfil" },
  { href: "#experiencia", label: "cd /experiencia" },
  { href: "#proyectos", label: "cd /proyectos" },
  { href: "#formacion", label: "cd /formación" },
  { href: "#sobre-mi", label: "cat sobre_mi.txt" },
  { href: "#contacto", label: "ping contacto" },
];

const sectionClass =
  "lg:min-h-[calc(100svh-var(--header-h))] flex flex-col justify-center py-3 sm:py-4 md:py-6 lg:py-8";
---

<Layout>
  <div class="scanlines"></div>

  <header
    id="site-header"
    class="w-full sticky top-0 z-50 bg-[var(--bg-window)] border-b-2 border-[var(--border-window)] shadow-[0_4px_0_0_rgba(0,255,0,0.2)] px-3 sm:px-4 md:px-8 py-2 lg:py-3"
  >
    <div
      class="max-w-[1600px] mx-auto flex justify-between items-center gap-3 relative"
    >
      <a
        href="#"
        aria-label="Volver arriba"
        class="min-w-0 text-white hover:text-[var(--accent-primary)] transition-colors no-underline hover-glitch"
      >
        <h1
          class="text-xl min-[380px]:text-2xl sm:text-3xl font-bold m-0 tracking-wider sm:tracking-widest uppercase whitespace-nowrap truncate"
        >
          root@molver:~$<span class="blink">_</span>
        </h1>
      </a>

      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Abrir menú"
        aria-controls="desktop-menu"
        aria-expanded="false"
        class="lg:hidden shrink-0 w-11 h-11 text-[var(--accent-primary)] bg-black border-2 border-[var(--border-window)] flex items-center justify-center shadow-[2px_2px_0px_0px_var(--border-window)] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none"
      >
        <i class="bi bi-list text-2xl font-bold" data-icon></i>
      </button>

      <nav
        id="desktop-menu"
        aria-label="Navegación principal"
        class="hidden lg:flex flex-col lg:flex-row lg:flex-wrap lg:justify-end absolute lg:static top-[calc(100%+0.5rem+2px)] -left-3 -right-3 sm:-left-4 sm:-right-4 md:-left-8 md:-right-8 lg:inset-auto bg-[var(--bg-window)] lg:bg-transparent border-b-2 lg:border-b-0 border-[var(--border-window)] gap-0 lg:gap-x-5 xl:gap-x-6 lg:gap-y-1 px-4 sm:px-6 md:px-8 py-2 lg:p-0 max-h-[calc(100svh-var(--header-h))] overflow-y-auto lg:overflow-visible lg:max-h-none shadow-[0_6px_0_0_rgba(0,255,0,0.15)] lg:shadow-none"
      >
        {
          NAV_LINKS.map((link) => (
            <a
              href={link.href}
              class="retro-menu-item text-xl lg:text-lg xl:text-xl py-3 lg:py-0 border-b border-dashed border-[var(--border-dim)] last:border-b-0 lg:border-b-0 text-[var(--text-primary)] hover:text-white decoration-none whitespace-nowrap"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </header>

  <main
    class="w-full max-w-[1600px] mx-auto px-3 sm:px-4 md:px-8 flex flex-col overflow-x-clip"
  >
    <section id="perfil" class={sectionClass}>
      <RetroWindow title="PERFIL: diego_molv3r" class="w-full">
        <Hero />
      </RetroWindow>
    </section>

    <section id="experiencia" class={sectionClass}>
      <RetroWindow title="EXPERIENCIA: laboral" class="w-full">
        <div class="p-3 sm:p-5 md:p-8">
          <Experience />
        </div>
      </RetroWindow>
    </section>

    <section id="proyectos" class={sectionClass}>
      <RetroWindow title="PROYECTOS: listado" class="w-full">
        <div class="p-3 sm:p-5 md:p-8">
          <Projects />
        </div>
      </RetroWindow>
    </section>

    <section id="formacion" class={sectionClass}>
      <RetroWindow title="FORMACIÓN: estudios" class="w-full">
        <div class="p-3 sm:p-5 md:p-8">
          <Training />
        </div>
      </RetroWindow>
    </section>

    <section id="sobre-mi" class={sectionClass}>
      <RetroWindow title="INFO: sobre_mi.txt" class="w-full">
        <div class="p-0">
          <AboutMe />
        </div>
      </RetroWindow>

      <RetroWindow title="SYS: specs_stack.exe" class="w-full mt-6 md:mt-8">
        <div class="p-3 sm:p-5 md:p-8">
          <TechStack />
        </div>
      </RetroWindow>
    </section>

    <section id="contacto" class={`${sectionClass} mb-20 md:mb-16`}>
      <RetroWindow title="RED: contacto" class="w-full">
        <div class="p-3 sm:p-5 md:p-8">
          <Contact />
        </div>
      </RetroWindow>
    </section>
  </main>
</Layout>

<script>
  const header = document.getElementById("site-header");
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("desktop-menu");
  const icon = btn?.querySelector("[data-icon]");
  const desktopMq = window.matchMedia("(min-width: 1024px)");

  // Mantiene --header-h sincronizado con la altura real del header (scroll-padding y alturas de sección)
  const syncHeaderHeight = () => {
    if (header) {
      document.documentElement.style.setProperty(
        "--header-h",
        `${header.offsetHeight}px`
      );
    }
  };
  syncHeaderHeight();
  if (header && "ResizeObserver" in window) {
    new ResizeObserver(syncHeaderHeight).observe(header);
  }

  const setOpen = (open: boolean) => {
    if (!btn || !menu) return;
    menu.classList.toggle("hidden", !open);
    menu.classList.toggle("flex", open);
    btn.setAttribute("aria-expanded", String(open));
    btn.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    if (icon) {
      icon.classList.toggle("bi-list", !open);
      icon.classList.toggle("bi-x-lg", open);
    }
  };

  const isOpen = () => btn?.getAttribute("aria-expanded") === "true";

  if (btn && menu) {
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      setOpen(!isOpen());
    });

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        if (!desktopMq.matches) setOpen(false);
      });
    });

    // Cerrar al tocar fuera del menú
    document.addEventListener("click", (e) => {
      if (!isOpen() || desktopMq.matches) return;
      if (!header?.contains(e.target as Node)) setOpen(false);
    });

    // Cerrar con Escape
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen()) {
        setOpen(false);
        btn.focus();
      }
    });

    // Al pasar a escritorio se resetea el estado del menú móvil
    desktopMq.addEventListener("change", () => setOpen(false));
  }
</script>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
</style>
